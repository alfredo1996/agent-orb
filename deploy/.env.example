# Copy to deploy/.env (git-ignored) and replace the value, e.g. with `openssl rand -hex 24`.
# The mod sends ORB_TOKEN as `Authorization: Bearer <token>` on POST /ingest.
ORB_TOKEN=change-me
# Optional (Slice 7): an Anthropic API key for the Analysis page. Billed per token to its credits, and only when you
# confirm a run in the studio; the studio never shows it. Leave it empty and the page says no key is set.
ANTHROPIC_API_KEY=
# Only if the key is not scoped to a workspace (the API then asks for one): the workspace ID, from the Console's
# Workspaces page. Not a secret, but the requests are billed to it.
ANTHROPIC_WORKSPACE_ID=
